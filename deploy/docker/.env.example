MYSQL_DATABASE=skin
MYSQL_USER=skin
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

WECHAT_APPID=replace_with_real_appid
WECHAT_SECRET=replace_with_real_secret

DEEPSEEK_API_KEY=replace_with_real_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

OSS_ENDPOINT=replace_with_oss_endpoint
OSS_BUCKET=replace_with_oss_bucket
OSS_REGION=replace_with_oss_region
OSS_ACCESS_KEY_ID=replace_with_oss_access_key_id
OSS_ACCESS_KEY_SECRET=replace_with_oss_access_key_secret

# skin-server calls skin-model through the Docker host. Keep this value when
# the host listens on 19090 via an SSH tunnel.
MODEL_SERVICE_BASE_URL=http://host.docker.internal:19090
MODEL_SERVICE_PREDICT_PATH=/api/v1/predict
